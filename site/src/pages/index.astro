---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import {
	FORM_ANCHOR,
	FORM_ID,
	FORM_URL,
	facts,
	hero,
	sponsors,
	team,
} from '../site.config';

const title = `${team.name} — ${team.number}`;
const description =
	"FRC Team 11243 designs, builds, wires and drives a 120-pound competition robot every winter. Now recruiting for the 2027 season — no experience needed.";
---

<Layout title={title} description={description}>
	<header class="wrap site-header">
		<div class="brand">
			<div class="brand-mark" aria-hidden="true"></div>
			<span class="brand-name">{team.name}</span>
			<span class="tag brand-tag">{team.number}</span>
		</div>
		<button
			type="button"
			class="btn btn-secondary theme-toggle"
			aria-pressed="false"
			aria-label="Toggle dark mode"
		>
			<span data-when="light">☾ Dark</span>
			<span data-when="dark">☀ Light</span>
		</button>
	</header>

	<main>
		<section class="wrap hero">
			<div class="hero-copy">
				<span class="kicker hero-kicker">Now recruiting · 2027 season</span>
				<h1 class="hero-title">Come build robots with {team.name}.</h1>
				<p class="hero-lede">
					We're FRC Team 11243 — A robotics team that creates a 120-pound autonomous robot every winter as a part of league of thousands of teams
					Students to everything, from designing and creating the robot to wiring, coding, and driving it. All experience levels are more than welcome.
				</p>
				<a class="btn btn-primary hero-cta" href={FORM_ANCHOR}>
					Sign up to join →
				</a>
				<span class="hero-fineprint">
					No experience needed · All grades welcome
				</span>
			</div>
			<div class="hero-media washed">
				<ImageSlot
					src={hero.src}
					alt={hero.alt}
					label="students working on the robot"
					eager
				/>
			</div>
		</section>

		<section class="wrap facts">
			{
				facts.map((fact) => (
					<span>
						<strong>{fact.label}</strong> · {fact.value}
					</span>
				))
			}
		</section>

		<section class="wrap two">
			<div class="two-col">
				<h2>What we do</h2>
				<p>
					Every January FIRST announces a new game, and we get six weeks to build
					a robot that plays it. Students run the CAD, machining, wiring, code
					and driving.
				</p>
			</div>
			<div class="two-col">
				<h2>Where you'd fit</h2>
				<p>
					Mechanical, electrical, programming, CAD, media, business and scouting
					— every one is a real job here. You can try them all, or focus on what you already know.
				</p>
			</div>
		</section>

		<section class="wrap signup" id="signup-form">
			<div class="signup-head">
				<h2>Sign up to join</h2>
				<p>
					Complete this short form and we'll reach out  with more info!
				</p>
			</div>
			<div class="signup-frame">
				<div
					class="fillout-embed"
					data-fillout-id={FORM_ID}
					data-fillout-embed-type="standard"
					data-fillout-inherit-parameters
					data-fillout-dynamic-resize
				>
				</div>
			</div>
			<p class="signup-fallback">
				Form not loading? <a href={FORM_URL} target="_blank" rel="noopener noreferrer">
					Open it in a new tab
				</a>.
			</p>
			{/* Third-party embed loader — is:inline keeps Astro from bundling it. */}
			<script is:inline src="https://server.fillout.com/embed/v1/"></script>
		</section>

		<section class="wrap sponsors">
			<div class="kicker sponsors-kicker">Supported by</div>
			<div class="sponsor-row">
				{
					sponsors.map((sponsor) => (
						<div class="sponsor-slot">
							<ImageSlot
								src={sponsor.src}
								alt={`${sponsor.name} logo`}
								label="sponsor logo"
							/>
						</div>
					))
				}
			</div>
		</section>
	</main>

	<footer class="wrap site-footer">
		<div class="site-footer-inner">
			<span>{team.email}</span>
			<span class="site-footer-links">
				<a href={team.instagram}>Instagram</a>
				<a href={team.github}>GitHub</a>
			</span>
		</div>
	</footer>
</Layout>
